# IdentityServer (STS) — 클라우드호스피탈이 제공
STS_ISSUER=https://identity.cloudhospital.com
STS_CLIENT_ID=hospital-content-client
STS_CLIENT_SECRET=REPLACE_ME
STS_SCOPE=openid profile email offline_access hospital-content-api

# 매니저 계정 (계약 후 발급)
MANAGER_EMAIL=manager@hospital.example.com

# CloudHospital Content API base URL
API_BASE_URL=https://admin-api.icloudhospital.com

# CIBA polling
CIBA_POLL_INTERVAL_SECONDS=5
CIBA_POLL_TIMEOUT_SECONDS=300

# 토큰 캐시 파일 (로컬 개발용, 프로덕션에서는 안전한 저장소 사용)
TOKEN_CACHE_FILE=.tokens.json

# 병원(호스피탈) ID — 아티클 생성 시 필수 (계약 시 발급받은 GUID)
HOSPITAL_ID=00000000-0000-0000-0000-000000000000

# 예제 03 이미지 업로드용 (선택; 기본값 assets/sample.jpg)
SAMPLE_IMAGE_PATH=
# SAMPLE_IMAGE_MIME 은 비워두면 파일 확장자로 자동 추론됩니다 (png/jpeg/webp...). 필요 시만 지정.
SAMPLE_IMAGE_MIME=


# 아티클 언어 (admin UI 목록이 이 언어로 필터링됨). 한국어 콘텐츠면 ko / ko-KR
ARTICLE_LANGUAGE_CODE=en-US
