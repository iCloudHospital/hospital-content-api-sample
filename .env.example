# IdentityServer (STS) — 클라우드호스피탈이 제공
STS_ISSUER=https://identity.cloudhospital.com
STS_CLIENT_ID=hospital-local-manager-sample
STS_CLIENT_SECRET=REPLACE_ME
STS_SCOPE=openid profile email offline_access hospital-content-api

# 매니저 계정 (계약 후 발급)
MANAGER_EMAIL=manager@hospital.example.com

# CloudHospital Content API base URL
API_BASE_URL=https://api.cloudhospital.com

# CIBA polling
CIBA_POLL_INTERVAL_SECONDS=5
CIBA_POLL_TIMEOUT_SECONDS=300

# 토큰 캐시 파일 (로컬 개발용, 프로덕션에서는 안전한 저장소 사용)
TOKEN_CACHE_FILE=.tokens.json
